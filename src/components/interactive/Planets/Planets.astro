---
import git from "@assets/icons/tech/git.svg";
import nodejs from "@assets/icons/tech/nodejs.svg";
import angular from "@assets/icons/tech/angular.svg";
import react from "@assets/icons/tech/react.svg";
import go from "@assets/icons/tech/go.svg";
import rust from "@assets/icons/tech/rust.svg";
import { Image } from "astro:assets";
import Logo from "@components/common/Logo.astro";

import "./planets.css";

interface Planet {
	name: string;
	src: ImageMetadata;
	glow: string;
}

interface Orbit {
	radius: number;
	duration: number;
	reverse?: boolean;
	planets: Planet[];
}

const orbits: Orbit[] = [
	{
		radius: 34,
		duration: 18,
		planets: [
			{ name: "Angular", src: angular, glow: "#dd0031" },
			{ name: "Git", src: git, glow: "#f05032" },
		],
	},
	{
		radius: 58,
		duration: 28,
		reverse: true,
		planets: [
			{ name: "Node.js", src: nodejs, glow: "#5fa04e" },
			{ name: "Go", src: go, glow: "#00add8" },
		],
	},
	{
		radius: 82,
		duration: 40,
		planets: [
			{ name: "React", src: react, glow: "#61dafb" },
			{ name: "Rust", src: rust, glow: "#f74c00" },
		],
	},
];
---

<div class="solar-system" role="group" aria-label="Technologies I work with" data-solar-system>
	<div class="sun" aria-hidden="true">
		<span class="sun-corona"></span>
		<span class="sun-core"><Logo /></span>
	</div>

	{
		orbits.map((orbit, orbitIndex) => (
			<div
				class:list={["orbit", { "orbit-reverse": orbit.reverse }]}
				style={`--r: ${orbit.radius}px; --duration: ${orbit.duration}s;`}>
				{orbit.planets.map((planet, planetIndex) => (
					<div
						class="orbit-arm"
						style={`--phase: ${planetIndex / orbit.planets.length + orbitIndex * 0.17};`}>
						<button
							type="button"
							class="planet"
							style={`--glow: ${planet.glow};`}
							aria-label={planet.name}
							aria-pressed="false">
							<span class="planet-upright">
								<span class="planet-body">
									<Image src={planet.src} alt="" class="planet-icon" width={16} height={16} />
								</span>
								<span class="planet-label" aria-hidden="true">
									{planet.name}
								</span>
							</span>
						</button>
					</div>
				))}
			</div>
		))
	}
</div>

<script>
	// Clicking a planet pins it: the system holds still and keeps its label visible.
	document.addEventListener("click", event => {
		const planet = (event.target as Element | null)?.closest?.<HTMLButtonElement>(".solar-system .planet");
		if (!planet) return;
		const system = planet.closest<HTMLElement>("[data-solar-system]");
		if (!system) return;

		const wasPinned = planet.getAttribute("aria-pressed") === "true";
		system.querySelectorAll(".planet").forEach(p => p.setAttribute("aria-pressed", "false"));
		planet.setAttribute("aria-pressed", String(!wasPinned));
		system.toggleAttribute("data-pinned", !wasPinned);
	});
</script>
