---
import { settings } from "@i18n/settings.const";

interface Props {
	className?: string;
	hideQuote?: boolean;
}

const { className = '', hideQuote = false } = Astro.props;
---

<div class={`flex items-start flex-col justify-center mb-12 md:flex-col gap-4 ${className}`}>
	{!hideQuote &&
		<span class="text-sm w-64">
			<i>Code is like humor. When you have to explain it, it's bad.</i>
			<br />
			— Cory House
		</span>
	}
	<div class="flex flex-col items-start justify-center">
		<span class="tel f-mono font-bold clickable">
		</span>
		<span class="email text-sm f-sans clickable underline-hover-effect">
			<a href={`mailto:${settings.business.contact.email}`}>
				{settings.business.contact.email}
			</a>
		</span>
	</div>
</div>
