---
interface Props {
	title: string;
	hasFooter?: boolean;
	reverse?: boolean;
	colSpanBigger?: boolean;
}
const { title, hasFooter, colSpanBigger: colSpan, reverse } = Astro.props;
---

<article
	class:list={[
		"bento-card group relative isolate flex overflow-hidden rounded-2xl p-8",
		colSpan ? "lg:col-span-2" : "lg:col-span-1",
		reverse ? "flex-col-reverse" : "flex-col",
	]}
	data-reveal>
	<slot name="preTitle" />
	<div>
		<h3 class="mt-3 mb-1 text-lg font-semibold text-white">
			{title}
		</h3>
		<slot name="subTitle" />

		<p class="max-w-fit text-sm font-normal text-neutral-400">
			<slot />
		</p>
	</div>

	{
		hasFooter && (
			<div class="z-40 mt-4 max-h-80">
				<slot name="footer" />
			</div>
		)
	}
</article>

<script>
	// A single delegated listener drives the spotlight for every card on the page.
	let pending: PointerEvent | null = null;

	const update = () => {
		const event = pending;
		pending = null;
		const card = (event?.target as Element | null)?.closest?.<HTMLElement>(".bento-card");
		if (!event || !card) return;
		const rect = card.getBoundingClientRect();
		card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
		card.style.setProperty("--my", `${event.clientY - rect.top}px`);
	};

	document.addEventListener(
		"pointermove",
		event => {
			if (event.pointerType !== "mouse") return;
			if (!pending) requestAnimationFrame(update);
			pending = event;
		},
		{ passive: true }
	);
</script>

<style>
	.bento-card {
		--mx: 50%;
		--my: 0%;
		background: linear-gradient(180deg, rgba(20, 25, 40, 0.72), rgba(9, 11, 20, 0.78));
		border: 1px solid rgba(255, 255, 255, 0.07);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			0 24px 60px -28px rgba(0, 0, 0, 0.8);
		transition:
			border-color 0.4s ease,
			box-shadow 0.4s ease;
	}

	.bento-card:hover {
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.07),
			0 30px 70px -28px rgba(0, 0, 0, 0.9),
			0 0 50px -20px rgba(98, 190, 255, 0.25);
	}

	/* Spotlight that lights up the border where the cursor is. */
	.bento-card::before {
		content: "";
		position: absolute;
		inset: -1px;
		z-index: 1;
		padding: 1px;
		border-radius: inherit;
		background: radial-gradient(
			320px circle at var(--mx) var(--my),
			rgba(140, 210, 255, 0.55),
			rgba(140, 160, 255, 0.15) 40%,
			transparent 70%
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask:
			linear-gradient(#000 0 0) content-box exclude,
			linear-gradient(#000 0 0);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	/* Soft starlight wash inside the card. */
	.bento-card::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(520px circle at var(--mx) var(--my), rgba(98, 160, 255, 0.07), transparent 60%);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.bento-card:hover::before,
	.bento-card:hover::after {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.bento-card[data-reveal="hidden"] {
			opacity: 0;
			transform: translateY(24px) scale(0.98);
		}

		.bento-card[data-reveal="visible"] {
			transition:
				opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms),
				transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms),
				border-color 0.4s ease,
				box-shadow 0.4s ease;
		}
	}
</style>
