---
interface Props {
    title: string;
    hasFooter?: boolean;
    reverse?: boolean;
    colSpanBigger?: boolean;
}
const { title, hasFooter, colSpanBigger: colSpan, reverse } = Astro.props;
---

<div class={`${colSpan ? 'lg:col-span-2' : 'lg:col-span-1'} flex ${reverse ? 'flex-col-reverse' : 'flex-col'} p-8 rounded-2xl bg-white/[0.03] group z-0 border border-white/[0.06] overflow-hidden`}>
	<slot name="preTitle" />
    <div>
        <span class="text-lg font-semibold text-white my-3">
            {title}
        </span>
        <slot name="subTitle" />

        <p class="text-sm font-normal text-neutral-400 max-w-fit">
            <slot />
        </p>
    </div>

    {hasFooter &&
        <div class="mt-4 max-h-80 z-40">
            <slot name="footer" />
        </div>
    }
</div>
