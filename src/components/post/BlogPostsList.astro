---
import type { Post } from '@libs/post';
import BlogPostPreview from './BlogPostPreview/BlogPostPreview.astro';

export interface Props {
	class?: string;
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="m-0 mb-[10vh] list-none p-0 flex justify-center flex-col items-center gap-12">
	{
		posts.map((post) => (
			<li class="max-w-[60rem] w-full">
				<BlogPostPreview post={post} />
			</li>
		))
	}
</ul>
