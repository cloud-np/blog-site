---
import { Icon } from "astro-icon/components";
import { shareSocials } from "../../data/share-socials.const";

interface Props {
	postTitle: string;
}

const currUrl = Astro.url.toString();
const postTitle = Astro.props.postTitle;
---

<div class="mx-auto mt-12 max-w-[42.875rem] border-t border-white/5 pt-6 pb-8">
	<div class="flex items-center justify-between">
		<span class="text-xs tracking-widest text-neutral-500 uppercase">Share</span>
		<ul class="flex list-none gap-3">
			{
				shareSocials.map(social => (
					<li>
						<a
							href={social.url.replace("[post-url]", currUrl).replace("[post-title]", postTitle)}
							title={social.name}
							class="flex items-center opacity-50 transition-opacity duration-200 hover:opacity-100">
							<Icon name={social.icon} width={20} height={20} />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</div>
