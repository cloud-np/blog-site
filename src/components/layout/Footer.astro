---
import { settings } from '@i18n/settings.const';
import SocialList from '@components/common/SocialList.astro';
import Logo from '@components/common/Logo.astro';
import ContactInfo from '@components/common/ContactInfo.astro';
---

<footer class="mt-auto pt-20 pb-8 px-8">
	<!-- Top Bar -->
	<div class="pt-8 border-t border-gray-800">
	</div>
	<div class="flex justify-center max-w-7xl mx-auto">
		<div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-12 mb-10">
			<!-- Brand Section -->
			<div class="flex flex-col items-center md:items-start gap-4 flex-1">
				<span class="w-24 transition-transform hover:scale-105">
					<Logo />
				</span>
				<p class="text-sm text-gray-500">
					Sharing thoughts on development, design, and technology.
				</p>
			</div>

			<!-- Contact Section -->
			<div class="flex flex-col items-center md:items-start flex-1">
				<h3 class="text-sm font-semibold uppercase tracking-wider mb-4 text-gray-900 dark:text-gray-100">
					Get in Touch :D
				</h3>
				<ContactInfo hideQuote />
			</div>

			<!-- Social Section -->
			<div class="flex flex-col items-center md:items-start flex-1">
				<h3 class="text-sm font-semibold uppercase tracking-wider mb-4 text-gray-900 dark:text-gray-100">
					Connect
				</h3>
				<SocialList />
			</div>
		</div>
	</div>
	<p class="pt-8 text-center text-sm text-gray-600">
		&copy; {new Date().getFullYear()} {settings.name}. All rights reserved.
	</p>
</footer>
