---
import { settings } from "@i18n/settings.const";
import SocialList from "@components/common/SocialList.astro";
---

<footer class="mt-auto px-6 pt-20 pb-8">
	<div class="mx-auto max-w-7xl border-t border-white/5 pt-8">
		<div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
			<p class="text-xs text-neutral-600">
				&copy; {new Date().getFullYear()} {settings.name}
			</p>
			<SocialList />
		</div>
	</div>
</footer>
