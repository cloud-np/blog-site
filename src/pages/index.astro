---
import PageLayout from "@layouts/PageLayout.astro";
import BlogPostsList from "@components/post/BlogPostsList.astro";
import { getPosts } from "@libs/post";
import SceneController from "@components/interactive/SceneController/SceneController.astro";
import abyss from "@assets/home-page/bento-box-section/abyss.jpg";
import aktis from "@assets/home-page/bento-box-section/aktis.jpg";
import bentoBox from "@assets/home-page/bento-box-section/bento-box.gif";
import betterNetflix from "@assets/home-page/bento-box-section/better-netflix.png";
import fromHome from "@assets/home-page/bento-box-section/fromHome.png";
import igame from "@assets/home-page/bento-box-section/igame.png";
import oino8eh from "@assets/home-page/bento-box-section/oino8eh.png";
import pumkin from "@assets/home-page/bento-box-section/pumkin.jpg";
import yang from "@assets/home-page/bento-box-section/yang.gif";
import zed from "@assets/home-page/bento-box-section/zed.jpg";
import TaskScheduling from "@components/interactive/TaskScheduling.svelte";
import Planets from "@components/interactive/Planets/Planets.astro";
import BentoCard from "@components/content/BentoCard.astro";
import Slider from "@components/interactive/Slider.svelte";
import Chess from "@components/interactive/Chess/Chess.svelte";
import { Image } from "astro:assets";
import { Helpers } from "@utils/helpers";
import "../styles/index.css";

const seo = {
	title: "cloud-np",
	description: "A programming focused blog.",
};

const allPosts = await getPosts(undefined);
const posts = allPosts.filter(post => !(post as any).personal);

const events = [
	{ title: "Joined @ Cloudflare", date: "01-12-2025" },
	{ title: "Released Meteor theme", date: "01-06-2024" },
	{ title: "Re-launched nuro.dev", date: "26-05-2024" },
	{ title: "Joined @ RONIN", date: "15-12-2022" },
	{ title: "Joined @ Wander", date: "14-03-2022" },
	{ title: "Launched nuro.dev", date: "22-10-2021" },
	{ title: "Joined @ Attio", date: "15-03-2021" },
];

const galleryImages = [
	{ src: abyss, alt: "Abyss signature" },
	{ src: aktis, alt: "Aktis logo design" },
	{ src: zed, alt: "Zed signature" },
	{ src: oino8eh, alt: "Οινοθέη logo design" },
	{ src: pumkin, alt: "Pumkin signature" },
	{ src: yang, alt: "Yang project" },
	{ src: betterNetflix, alt: "Better Netflix project" },
	{ src: igame, alt: "iGame project" },
	{ src: fromHome, alt: "From Home project" },
	{ src: bentoBox, alt: "BentoBox project" },
];
---

<PageLayout seo={seo}>
	<!-- <Reveal /> -->
	<SceneController />
	<div class="container flex flex-col">
		<section class="landing mx-8 overflow-hidden px-6">
			<div class="moon moon-left"></div>
			<div class="moon moon-right top-[20vh] left-[80vw]"></div>
			<div class="mb-12 flex flex-col items-center justify-center transition-all duration-300 ease-out">
				<h1 class="hero-name slow-fade mb-6 font-bold">Hi I'm Nick</h1>
				<p class="hero-role mb-2 text-neutral-400">Engineering Tech Lead / Full-Stack Developer</p>
				<p class="hero-text slow-fade">I build scalable web applications and lead engineering teams.</p>
			</div>
			<!-- <div class="hero-tables grid w-full grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
				<div class="hero-table-col">
					<h2 class="mb-4 text-xs tracking-widest text-neutral-500 uppercase">Posts</h2>
					<ul class="flex flex-col gap-0">
						{
							posts.slice(0, 8).map(post => (
								<li>
									<a
										href={post.href}
										class="hero-table-row group flex items-baseline justify-between border-b border-white/5 py-2 transition-colors duration-200 hover:border-white/15">
										<span class="mr-4 truncate text-sm text-neutral-300 transition-colors duration-200 group-hover:text-white">
											{post.data.title}
										</span>
										<span class="shrink-0 text-xs text-neutral-600 tabular-nums">
											{Helpers.formatDate(post.data.publishedAt)}
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div> -->
			<!-- <div class="hero-table-col">
					<h2 class="mb-4 text-xs tracking-widest text-neutral-500 uppercase">History</h2>
					<ul class="flex flex-col gap-0">
						{
							events.map(event => (
								<li class="hero-table-row flex items-baseline justify-between border-b border-white/5 py-2">
									<span class="mr-4 truncate text-sm text-neutral-300">{event.title}</span>
									<span class="shrink-0 text-xs text-neutral-600 tabular-nums">{event.date}</span>
								</li>
							))
						}
					</ul>
				</div> -->
			<!-- </div> -->
		</section>
		<!-- <h2 class="selected-work-heading mx-8 my-6 text-xl font-normal">Selected Work</h2> -->
		<div class="mx-6 mb-10 grid max-w-7xl grid-cols-1 gap-4 lg:grid-cols-3">
			<BentoCard title="Engineering Tech Lead">
				<div slot="preTitle" class="relative h-50 w-full overflow-hidden">
					<Planets />
				</div>
				<div slot="subTitle">
					<p class="pb-2 text-sm text-neutral-200 italic">betsson - Sportsbook</p>
				</div>
				Developed critical features serving millions of users globally, integrating new API providers to expand market
				reach and app capabilities. Built and maintained high-performance sportsbook application using Angular, mfe,
				NgRx, and Nx across B2B/B2C platforms (mobile, desktop, native). Collaborated with architects on technical
				guidelines while mentoring development teams to ensure optimal user experience and system reliability.
			</BentoCard>
			<BentoCard
				title="Bin Packing Heuristics for the 'Multiple Workflow Scheduling Problem'"
				hasFooter={true}
				colSpanBigger>
				Under the guidance of Dr. Panagiotis Oikonomou, I researched MWSP (Multiple Workflow Scheduling Problem)
				which is a NP-hard problem with conflicting optimization goals. Our proposed algorithm achieved up to a
				9% improvement and unveiled various trade-offs depending on the specific characteristics of each
				workflow and optimization objectives.
				<a href="https://dl.acm.org/doi/10.1145/3503823.3503876" target="_blank" slot="footer">
					View Publication
				</a>

				<TaskScheduling slot="preTitle" client:load />
			</BentoCard>
			<BentoCard title="Freelancing and web design" hasFooter={true} colSpanBigger>
				With a perfect score when it comes to customer satisfaction, I pride my self delivering only best for my
				clients.

				<div slot="footer" class="min-h-50 w-full">
					<Slider client:only initialXOffset={600}>
						{
							galleryImages.map(image => (
								<div class="gallery-item" data-slide>
									<Image class="gallery-image" draggable={false} src={image.src} alt={image.alt} />
								</div>
							))
						}
					</Slider>
				</div>
			</BentoCard>
			<BentoCard title="chessnp.com" hasFooter={true} reverse>
				<div slot="subTitle">
					<p class="inline text-sm">🚧</p>
					<p class="inline pb-2 text-sm text-neutral-200 italic">Under Construction</p>
				</div>
				chessnp.com lets users replay famous historical chess matches and play against a custom AI chess engine built
				entirely from scratch using Go.
				<div slot="footer">
					<Chess client:load />
					<p class="text-gray-500 line-through">Visit chessnp.com</p>
				</div>
			</BentoCard>
		</div>
	</div>
	<section class="mx-6 mt-20 flex flex-col items-center justify-center">
		<h2 class="fade-in mb-16 text-3xl font-normal">Latest Posts</h2>
		<BlogPostsList class="pt-16" posts={posts.slice(0, 3)} />
		<a href="/blog" class="mt-8 text-neutral-400 transition-colors duration-200 hover:text-white">
			View all posts &rarr;
		</a>
	</section>
</PageLayout>

<style>
	.hero-name {
		font-size: min(3.5rem, 8vw);
		opacity: 0;
		transform: translateY(20px);
	}

	.hero-role {
		font-size: 1rem;
		letter-spacing: 0.05em;
		opacity: 0;
		transform: translateY(20px);
	}

	.hero-text {
		font-size: 1rem;
		opacity: 0;
		transform: translateY(20px);
		max-width: 550px;
		color: var(--c-text_light);
	}

	.hero-tables {
		opacity: 0;
		transform: translateY(15px);
	}

	.selected-work-heading {
		opacity: 0;
		transform: translateY(10px);
	}
</style>

<script>
	import gsap from "gsap";

	function init(delay: number = 0) {
		const tl = gsap.timeline({
			defaults: { ease: "power2.out" },
		});

		tl.to(".hero-name", { duration: 0.6, opacity: 1, y: 0, delay })
			.to(".hero-role", { duration: 0.5, opacity: 1, y: 0 }, "-=0.3")
			.to(".hero-text", { duration: 0.5, opacity: 1, y: 0 }, "-=0.3")
			.to(".hero-tables", { duration: 0.6, opacity: 1, y: 0 }, "-=0.2")
			.to(".selected-work-heading", { duration: 0.5, opacity: 1, y: 0 }, "-=0.3");

		const elements = document.querySelectorAll(".slow-fade") as NodeListOf<HTMLElement>;
		document.addEventListener("mousemove", mouseEvent => {
			elements.forEach(el => {
				const rect = el.getBoundingClientRect();
				const x = mouseEvent.pageX - rect.left;
				const y = mouseEvent.pageY - rect.top;

				const xPercent = (x / rect.width) * 100;
				const yPercent = (y / rect.height) * 100;

				const maskImage = `radial-gradient(
					circle at ${xPercent}% ${yPercent}%,
					rgba(255, 255, 255, 1) 0%,
					rgba(255, 255, 255, 0.9) 20%,
					rgba(255, 255, 255, 0.7) 40%,
					rgba(255, 255, 255, 0.5) 60%
				)`;

				el.style.maskImage = maskImage;
			});
		});
	}

	init();

	document.addEventListener("astro:after-swap", () => {
		if (window.location.pathname === "/" || window.location.pathname === "") {
			init();
		}
	});
</script>
