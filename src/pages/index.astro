---
import PageLayout from "@layouts/PageLayout.astro";
import BlogPostsList from "@components/post/BlogPostsList.astro";
import { getPosts } from "@libs/post";
import ScrollDown from "@components/interactive/ScrollDown.astro";
import SceneController from "@components/interactive/SceneController/SceneController.astro";
import Logo from "@components/common/Logo.astro";
import abyss from "@assets/home-page/bento-box-section/abyss.jpg";
import aktis from "@assets/home-page/bento-box-section/aktis.jpg";
import bentoBox from "@assets/home-page/bento-box-section/bento-box.gif";
import betterNetflix from "@assets/home-page/bento-box-section/better-netflix.png";
import fromHome from "@assets/home-page/bento-box-section/fromHome.png";
import igame from "@assets/home-page/bento-box-section/igame.png";
import oino8eh from "@assets/home-page/bento-box-section/oino8eh.png";
import pumkin from "@assets/home-page/bento-box-section/pumkin.jpg";
import yang from "@assets/home-page/bento-box-section/yang.gif";
import zed from "@assets/home-page/bento-box-section/zed.jpg";
import TaskScheduling from "@components/interactive/TaskScheduling.svelte";
import Planets from "@components/interactive/Planets/Planets.astro";
import BentoCard from "@components/content/BentoCard.astro";
import Slider from "@components/interactive/Slider.svelte";
import Chess from "@components/interactive/Chess/Chess.svelte";
import { Image } from "astro:assets";
import "../styles/index.css";

const seo = {
	title: "cloud-np",
	description: "A programming focused blog.",
};

const allPosts = await getPosts(undefined);
const posts = allPosts.filter((post) => !(post as any).personal);

const galleryImages = [
	{ src: abyss, alt: "Abyss signature" },
	{ src: aktis, alt: "Aktis logo design" },
	{ src: zed, alt: "Zed signature" },
	{ src: oino8eh, alt: "Οινοθέη logo design" },
	{ src: pumkin, alt: "Pumkin signature" },
	{ src: yang, alt: "Yang project" },
	{ src: betterNetflix, alt: "Better Netflix project" },
	{ src: igame, alt: "iGame project" },
	{ src: fromHome, alt: "From Home project" },
	{ src: bentoBox, alt: "BentoBox project" },
];
---

<PageLayout seo={seo}>
	<!-- <Reveal /> -->
	<SceneController />
	<div class="container flex flex-col">
		<section class="landing px-3 overflow-hidden">
			<div class="moon moon-left"></div>
			<div class="moon moon-right top-[20vh] left-[80vw]"></div>
			<div class="transition-all duration-300 ease-out mb-16 flex justify-center flex-col items-center">
				<div class="hero-title-container justify-center font-bold flex mb-10 overflow-hidden slow-fade">
					<h1 class="hero-title">Hi</h1>
					<h1 class="hero-title">there!</h1>
					<h1 class="hero-title">I'm</h1>
					<h1 class="hero-title">Nick</h1>
				</div>
				<div class="overflow-hidden mx-6 max-w-156">
					<p class="flex justify-center hero-text slow-fade">
						I enjoy coding, solving complex problems, and giving my best in everything I do.
						Other than that I enjoy nature and freediving.
					</p>
				</div>
			</div>
			<div class="m-auto scroll-down-indicator">
				<ScrollDown />
			</div>
		</section>
		<section class="portofolio-details flex self-center flex-col items-center">
			<div class="-mt-15 mb-4">
				<div class="gradient absolute"></div>
				<div class="w-28 h-28">
					<Logo />
				</div>
			</div>
			<div class="overflow-hidden h-18 flex justify-center mx-4">
				<h2 class="portofolio-title text-3xl font-medium translate-y-full text-center transition-all duration-300 ease-out">
					Portofolio and past projects
				</h2>
			</div>
			<div class="overflow-hidden h-auto flex justify-center mb-5 mx-4">
				<p class="portofolio-text translate-y-full text-center w-120 text-base">
					Explore a small collection of my work showcasing some
					skills, creativity, but most importantly dedication to
					quality.
				</p>
			</div>
		</section>
		<div class="bentobox-container grid grid-cols-1 lg:grid-cols-3 gap-2 m-10 max-w-7xl">
			<BentoCard title="Engineering Tech Lead">

				<div slot="preTitle" class="w-full h-50 relative overflow-hidden">
					<Planets />
				</div>
				<div slot="subTitle">
					<p class="text-sm italic text-neutral-200 pb-2">
						betsson - Sportsbook
					</p>
				</div>
				Developed critical features serving millions of users globally, integrating new API providers to expand market reach and app capabilities.
				Built and maintained high-performance sportsbook application using Angular, mfe, NgRx, and Nx across B2B/B2C platforms (mobile, desktop, native).
				Collaborated with architects on technical guidelines while mentoring development teams to ensure optimal user experience and system reliability.
			</BentoCard>
			<BentoCard
				title="Bin Packing Heuristics for the 'Multiple Workflow Scheduling Problem'"
				hasFooter={true}
				colSpanBigger
			>
				Under the guidance of Dr. Panagiotis Oikonomou, I researched
				MWSP (Multiple Workflow Scheduling Problem) which is a NP-hard problem with conflicting
				optimization goals. Our proposed algorithm achieved up to a
				9% improvement and unveiled various trade-offs depending on
				the specific characteristics of each workflow and optimization objectives.
				<a
					href="https://dl.acm.org/doi/10.1145/3503823.3503876"
					target="_blank"
					slot="footer"
				>
					View Publication
				</a>

				<TaskScheduling slot="preTitle" client:load />
			</BentoCard>
			<BentoCard title="Freelancing and web design" hasFooter={true} colSpanBigger >
				With a perfect score when it comes to customer satisfaction,
				I pride my self delivering only best for my clients.

				<div slot="footer" class="w-full min-h-50">
					<Slider client:only initialXOffset={600}>
						{galleryImages.map((image) => (
							<div class="gallery-item" data-slide>
								<Image class="gallery-image" draggable={false} src={image.src} alt={image.alt} />
							</div>
						))}
					</Slider>
				</div>
			</BentoCard>
			<BentoCard title="chessnp.com" hasFooter={true} reverse>
				<div slot="subTitle">
					<p class="text-sm inline">🚧</p>
					<p class="text-sm inline italic text-neutral-200 pb-2">
						Under Construction
					</p>
				</div>
				chessnp.com lets users replay famous historical chess matches
				and play against a custom AI chess engine built entirely
				from scratch using Go.
				<div slot="footer">
					<Chess client:load />
					<p class="text-gray-500 line-through">Visit chessnp.com</p>
				</div>
			</BentoCard>
		</div>
	</div>
	<section class="mx-6 mt-20 flex flex-col justify-center items-center">
		<h4 class="mb-16 fade-in text-2xl">Latest Posts</h4>
		<BlogPostsList class="pt-16" posts={posts} />
	</section>
</PageLayout>

<style>

	/* Do not include margin to the last char for small devices */
	.hero-title-container .hero-title:not(:last-child) {
		margin-right: 13px;
	}

	.hero-title {
		transform: translateY(100%);
		z-index: -1;
		font-size: min(6rem, 9vw);
		text-align: center;
		max-width: 100%;
		white-space: nowrap;
	}

	.hero-text {
		font-size: 1.3rem;
		transform: translateY(100%);
		max-width: min(var(--md-container), 600px);
		margin: auto;
		text-align: center;
	}
</style>


<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/all";
	import { scrollEl } from "@components/interactive/ScrollController/ScrollController";

	// const REVEAL_DELAY = 3.72;
	gsap.registerPlugin(ScrollTrigger);

	function init(delay: number = 0) {
		const tl = gsap.timeline({
			defaults: { ease: "power2.out" },
			scrollBehavior: "smooth",
		});
		const portofolioTl = gsap.timeline({
			defaults: { ease: "power2.out" },
			scrollBehavior: "smooth",
			paused: true,
		});
		portofolioTl
			.to(".portofolio-title", { duration: 0.8, y: 0 })
			.to(".portofolio-text", { duration: 0.8, y: 0 }, "-=0.4");

		tl.to(".hero-title", { duration: 0.8, y: 0, delay }).to(
			".hero-text",
			{ duration: 0.8, y: 0 },
			"-=0.4",
		);
		tl.to(".portofolio-details", {
			scrollTrigger: {
				trigger: ".portofolio-details",
				start: "top-=500 center",
				end: "center-=300 center",
				scrub: true,
			},
			width: "100vw",
			duration: 2.2,
		});
		tl.to(".portofolio-title", {
			scrollTrigger: {
				trigger: ".portofolio-details",
				start: "top center",
				end: "center center",
				scrub: true,
				onEnter: () => portofolioTl.play(),
			},
		});

		const elements = document.querySelectorAll('.slow-fade') as NodeListOf<HTMLElement>;
		document.addEventListener('mousemove', mouseEvent => {
			elements.forEach(el => {
				const rect = el.getBoundingClientRect();
				const x = mouseEvent.pageX - rect.left;
				const y = mouseEvent.pageY - rect.top;

				// Calculate the position in percentages
				const xPercent = (x / rect.width) * 100;
				const yPercent = (y / rect.height) * 100;

				// Apply radial gradient mask effect
				const maskImage = `radial-gradient(
					circle at ${xPercent}% ${yPercent}%,
					rgba(255, 255, 255, 1) 0%,
					rgba(255, 255, 255, 0.9) 20%,
					rgba(255, 255, 255, 0.7) 40%,
					rgba(255, 255, 255, 0.5) 60%
				)`;

				el.style.maskImage = maskImage;
			});
		});

	}

	scrollEl(".scroll-down-indicator", {
		opacity: () =>
			window.scrollY - 100 >= 0
				? Math.max(1 - (window.scrollY - 100) / 20, 0)
				: 1,
	});

	// init(REVEAL_DELAY);
	init();

	document.addEventListener("astro:after-swap", () => {
		if (window.location.pathname === '/' || window.location.pathname === '') {
			init();
		}
	});
</script>
