---
import PageLayout from "@layouts/PageLayout.astro";
import { getPosts } from "@libs/post";
import SceneController from "@components/interactive/SceneController/SceneController.astro";
import abyss from "@assets/home-page/bento-box-section/abyss.jpg";
import aktis from "@assets/home-page/bento-box-section/aktis.jpg";
import homeupgrades from "@assets/home-page/bento-box-section/homeupgrades.gif";
import betterNetflix from "@assets/home-page/bento-box-section/better-netflix.png";
import fromHome from "@assets/home-page/bento-box-section/fromHome.png";
import igame from "@assets/home-page/bento-box-section/igame.png";
import oino8eh from "@assets/home-page/bento-box-section/oino8eh.png";
import pumkin from "@assets/home-page/bento-box-section/pumkin.jpg";
import sailgreek from "@assets/home-page/bento-box-section/sailgreek.gif";
import zed from "@assets/home-page/bento-box-section/zed.jpg";
import TaskScheduling from "@components/interactive/TaskScheduling.svelte";
import Planets from "@components/interactive/Planets/Planets.astro";
import BentoCard from "@components/content/BentoCard.astro";
import Slider from "@components/interactive/Slider.svelte";
import Chess from "@components/interactive/Chess/Chess.svelte";
import { Image, getImage } from "astro:assets";
import { Helpers } from "@utils/helpers";
import "../styles/index.css";

const seo = {
	title: "cloud-np",
	description: "A programming focused blog.",
};

const allPosts = await getPosts(undefined);
const posts = allPosts.filter(post => !post.data.personal);

const postImages = await Promise.all(
	posts.slice(0, 8).map(async post => {
		const thumb = await getImage({ src: post.data.previewImage, width: 80, height: 80, format: "webp" });
		const bg = await getImage({ src: post.data.previewImage, width: 100, format: "webp", quality: 30 });
		return { slug: post.slug, thumb, bg };
	}),
);
const postImageMap = Object.fromEntries(postImages.map(p => [p.slug, p]));

const GALLERY_START = 0;
const galleryImages = [
	{ src: abyss, alt: "Abyss signature" },
	{ src: aktis, alt: "Aktis logo design" },
	{ src: zed, alt: "Zed signature" },
	{ src: oino8eh, alt: "Οινοθέη logo design" },
	{ src: pumkin, alt: "Pumkin signature" },
	{ src: sailgreek, alt: "SailGreek project" },
	{ src: betterNetflix, alt: "Better Netflix project" },
	{ src: igame, alt: "iGame project" },
	{ src: fromHome, alt: "From Home project" },
	{ src: homeupgrades, alt: "HomeUpgrades project" },
];
---

<PageLayout seo={seo}>
	<SceneController anchor="[data-hero]" />
	<div class="container flex flex-col">
		<section class="landing mx-8 px-6" data-hero>
			<div class="mb-12 flex flex-col items-center justify-center">
				<h1 class="hero-name slow-fade text-center text-6xl font-bold">Hi I'm Nick</h1>
				<p class="hero-role slow-fade mb-2 text-center text-neutral-400">
					Engineering Tech Lead / Full-Stack Developer
				</p>
				<p class="hero-text slow-fade text-center">
					I build scalable web applications and lead engineering teams.
				</p>
			</div>
		</section>
		<!-- <h2 class="selected-work-heading mx-8 my-6 text-xl font-normal">Selected Work</h2> -->
		<div class="bento-grid mx-6 mb-10 grid max-w-7xl grid-cols-1 gap-4 lg:grid-cols-3">
			<BentoCard title="Engineering Tech Lead">
				<div slot="preTitle" class="relative h-56 w-full">
					<Planets />
				</div>
				<div slot="subTitle">
					<p class="pb-2 text-sm text-neutral-200 italic">betsson - Sportsbook</p>
				</div>
				Led the frontend engineering of a high-performance sportsbook platform at Betsson, serving millions of users
				across mobile, desktop, and native apps. Helped steering architecture decisions around state management,
				integration of new stacks, and micro-frontends while owning the integration of new API providers to expand
				market reach. Shaped technical standards alongside architects, mentored developers, and enforced performance
				budgets and observability to keep the platform fast and reliable at scale.
			</BentoCard>
			<BentoCard
				title="Bin Packing Heuristics for the 'Multiple Workflow Scheduling Problem'"
				hasFooter={true}
				colSpanBigger>
				Under the guidance of Dr. Panagiotis Oikonomou, I researched MWSP (Multiple Workflow Scheduling Problem)
				which is a NP-hard problem with conflicting optimization goals. Our proposed algorithm achieved up to a
				9% improvement and unveiled various trade-offs depending on the specific characteristics of each
				workflow and optimization objectives.
				<a
					href="https://dl.acm.org/doi/10.1145/3503823.3503876"
					target="_blank"
					rel="noopener"
					slot="footer"
					class="group/link inline-flex items-center gap-1.5 text-sm font-medium text-sky-300 transition-colors hover:text-sky-200">
					View Publication
					<svg
						class="transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true">
						<path
							d="M7 17L17 7M9 7h8v8"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</a>

				<div slot="preTitle" class="flex flex-1 items-center">
					<TaskScheduling client:only="svelte" />
				</div>
			</BentoCard>
			<BentoCard title="Freelancing and web design" hasFooter={true} colSpanBigger>
				<div
					slot="preTitle"
					class="freelance-showcase relative flex h-52 w-full items-center justify-center"
					aria-hidden="true"
					data-showcase>
					<div class="showcase-float relative h-32 w-48">
						{
							[2, 1, 0].map(depth => (
								<div class={`showcase-card showcase-depth-${depth}`} data-depth={depth}>
									{galleryImages.map((image, i) => (
										<Image
											class="showcase-image"
											src={image.src}
											alt=""
											width={256}
											height={170}
											format="webp"
											data-active={i === (GALLERY_START + depth) % galleryImages.length ? "" : undefined}
										/>
									))}
								</div>
							))
						}
					</div>
				</div>
				With a perfect score when it comes to customer satisfaction, I pride myself in delivering only the best for
				my clients.

				<div slot="footer" class="w-full">
					<Slider client:only="svelte" startIndex={GALLERY_START} label="Freelance work">
						{
							galleryImages.map(image => (
								<div class="gallery-item" data-slide>
									<Image class="gallery-image" draggable={false} src={image.src} alt={image.alt} width={144} height={100} format="webp"  />
								</div>
							))
						}
					</Slider>
				</div>
			</BentoCard>
			<BentoCard title="chessnp.com" hasFooter={true} reverse>
				<div slot="subTitle">
					<p class="inline text-sm">🚧</p>
					<p class="inline pb-2 text-sm text-neutral-200 italic">Under Construction</p>
				</div>
				chessnp.com lets users replay famous historical chess matches and play against a custom AI chess engine built
				entirely from scratch using Go.
				<div class="flex flex-col items-center justify-center" slot="footer">
					<Chess client:only="svelte" />
					<p class="text-gray-400 line-through">Visit chessnp.com</p>
				</div>
			</BentoCard>
		</div>
	</div>

	<section class="container mt-20 flex flex-col justify-center gap-6 px-6">
		<div>
			<h2 class="mb-4 text-xs tracking-widest text-neutral-400 uppercase">Posts</h2>
			<ul class="flex flex-col gap-0">
				{
					posts.slice(0, 8).map(post => (
						<li>
							<a
								href={post.href}
								class="post-row hero-table-row group relative flex items-center justify-between overflow-hidden border-b border-white/5 py-2 transition-colors duration-200 hover:border-white/15">
								<div
									class="post-row-bg pointer-events-none absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-300 group-hover:opacity-25"
									style={`background-image: url(${postImageMap[post.slug]?.bg.src ?? post.data.previewImage.src});`}
								/>
								<div class="relative z-10 flex items-center gap-3 overflow-hidden">
									<Image
										src={post.data.previewImage}
										alt={`Preview image for ${post.data.title}`}
										width={80}
										height={80}
										format="webp"
										class="h-10 w-10 shrink-0 rounded-md object-cover opacity-50 transition-opacity duration-200 group-hover:opacity-90"
									/>
									<span class="truncate text-sm text-neutral-200 transition-colors duration-200 group-hover:text-white">
										{post.data.title}
									</span>
								</div>
								<span class="relative z-10 ml-4 flex shrink-0 items-center gap-2 text-xs text-neutral-400 tabular-nums">
									{Helpers.formatDate(post.data.publishedAt)}
									<svg
										class="-translate-x-1 text-sky-300 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
										width="12"
										height="12"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true">
										<path
											d="M5 12h14M13 6l6 6-6 6"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</PageLayout>

<style>
	@keyframes reveal-up {
		from {
			opacity: 0;
			transform: translateY(var(--reveal-y, 20px));
			filter: blur(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: blur(0);
		}
	}

	/* The name comes into focus like something drifting out of deep space. */
	@keyframes name-in {
		from {
			opacity: 0;
			transform: translateY(20px) scale(0.96);
			filter: blur(12px) drop-shadow(0 0 0 rgba(110, 170, 255, 0));
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0) drop-shadow(0 0 28px rgba(110, 170, 255, 0.28));
		}
	}

	.hero-name {
		/* Room for the glow to fade out inside the spotlight mask instead of being clipped. */
		padding: 32px 40px;
		margin: -32px -40px calc(1.5rem - 32px);
		opacity: 0;
		background: linear-gradient(180deg, #ffffff 30%, #a3b7da 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: name-in 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.hero-role {
		font-size: 1rem;
		letter-spacing: 0.05em;
		opacity: 0;
		animation: reveal-up 0.7s cubic-bezier(0.33, 1, 0.68, 1) forwards;
		animation-delay: 0.35s;
		--reveal-y: 16px;
	}

	.hero-text {
		font-size: 1rem;
		opacity: 0;
		max-width: 550px;
		color: var(--c-text_light);
		animation: reveal-up 0.7s cubic-bezier(0.33, 1, 0.68, 1) forwards;
		animation-delay: 0.55s;
		--reveal-y: 16px;
	}

	.post-row-bg {
		filter: blur(20px) brightness(0.3) saturate(1.4);
		transform: scale(1.2);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-name,
		.hero-role,
		.hero-text {
			opacity: 1;
			animation: none;
		}

		.hero-name {
			filter: drop-shadow(0 0 28px rgba(110, 170, 255, 0.28));
		}
	}
</style>

<script>
	let cleanup: (() => void) | null = null;

	/** Text near the cursor is lit up, like a torch sweeping across the hero. */
	function initHeroSpotlight(signal: AbortSignal) {
		const hero = document.querySelector<HTMLElement>("[data-hero]");
		const elements = hero ? Array.from(hero.querySelectorAll<HTMLElement>(".slow-fade")) : [];
		if (!hero || !elements.length) return;

		let pending: PointerEvent | null = null;
		const update = () => {
			const event = pending;
			pending = null;
			if (!event) return;
			for (const el of elements) {
				const rect = el.getBoundingClientRect();
				el.style.setProperty("--spot-x", `${event.clientX - rect.left}px`);
				el.style.setProperty("--spot-y", `${event.clientY - rect.top}px`);
			}
		};

		document.addEventListener(
			"pointermove",
			event => {
				if (event.pointerType !== "mouse") return;
				// Nothing to light up once the hero has scrolled away.
				if (window.scrollY > hero.offsetTop + hero.offsetHeight) return;
				if (!pending) requestAnimationFrame(update);
				pending = event;
			},
			{ passive: true, signal }
		);
	}

	/** Keeps the floating showcase stack in sync with the gallery slider. */
	function initShowcase(signal: AbortSignal) {
		const showcase = document.querySelector<HTMLElement>("[data-showcase]");
		const card = showcase?.closest(".bento-card");
		if (!showcase || !card) return;

		card.addEventListener(
			"gallery:select",
			event => {
				const { index } = (event as CustomEvent<{ index: number }>).detail;
				showcase.querySelectorAll<HTMLElement>("[data-depth]").forEach(layer => {
					const images = layer.querySelectorAll("img");
					const active = (index + Number(layer.dataset.depth)) % images.length;
					images.forEach((img, i) => img.toggleAttribute("data-active", i === active));
				});
			},
			{ signal }
		);
	}

	/** Cards float in as they enter the viewport. */
	function initReveal() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return () => {};

		const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
		const observer = new IntersectionObserver(
			entries => {
				entries
					.filter(entry => entry.isIntersecting)
					.forEach((entry, i) => {
						const el = entry.target as HTMLElement;
						el.style.setProperty("--reveal-delay", `${i * 90}ms`);
						el.dataset.reveal = "visible";
						observer.unobserve(el);
					});
			},
			{ rootMargin: "0px 0px -8% 0px" }
		);

		for (const card of cards) {
			// Cards already on screen stay put; only the ones below the fold animate in.
			if (card.getBoundingClientRect().top < window.innerHeight * 0.92) continue;
			card.dataset.reveal = "hidden";
			observer.observe(card);
		}

		return () => observer.disconnect();
	}

	function initLanding() {
		cleanup?.();
		if (!document.querySelector("[data-hero]")) {
			cleanup = null;
			return;
		}

		const controller = new AbortController();
		initHeroSpotlight(controller.signal);
		initShowcase(controller.signal);
		const stopReveal = initReveal();

		cleanup = () => {
			controller.abort();
			stopReveal();
		};
	}

	document.addEventListener("astro:page-load", initLanding);
	document.addEventListener("astro:before-swap", () => {
		cleanup?.();
		cleanup = null;
	});
</script>
