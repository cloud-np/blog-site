---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/containers/Container.astro";
import BlogPostsList from "@components/post/BlogPostsList.astro";
import { getPosts } from "@libs/post";

const allPosts = await getPosts(undefined);
const posts = allPosts.filter(post => !post.data.personal);

const categories = ["All", ...new Set(posts.flatMap(post => post.data.searchCategories))].sort();

const seo = {
	title: "cloud-np | Tech Blog",
	description: "A simple blog focused on provided the best",
};
---

<PageLayout seo={seo}>
	<Container>
		<h1 class="my-15 text-center text-4xl">Blog</h1>

		<div class="mb-12 flex flex-wrap justify-center gap-2 px-4">
			{
				categories.map((cat, index) => (
					<button class={`category-filter rounded-full ${index === 0 ? "active" : ""}`} data-category={cat}>
						{cat}
					</button>
				))
			}
		</div>

		<BlogPostsList posts={posts} />
	</Container>
</PageLayout>

<style>
	.category-filter {
		padding: 0.35rem 0.85rem;
		border: 1px solid var(--c-bg_dark_2);
		background: transparent;
		color: var(--c-text);
		font-size: var(--step--2);
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.category-filter:hover {
		border-color: var(--c-text_light_hover);
		color: var(--c-text_light_hover);
	}

	.category-filter.active {
		background: var(--c-bg_dark_2);
		color: var(--c-text_light);
		border-color: var(--c-bg_dark_2);
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>(".category-filter");
	const items = document.querySelectorAll<HTMLLIElement>("#blog-posts-list li");

	buttons.forEach(btn => {
		btn.addEventListener("click", () => {
			buttons.forEach(b => b.classList.remove("active"));
			btn.classList.add("active");

			const selected = btn.dataset.category!;

			items.forEach(item => {
				if (selected === "All") {
					item.style.display = "";
				} else {
					const cats = (item.dataset.categories ?? "").split(",");
					item.style.display = cats.includes(selected) ? "" : "none";
				}
			});
		});
	});
</script>
