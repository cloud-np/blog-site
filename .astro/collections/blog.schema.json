{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "titleImage": {
      "type": "string"
    },
    "previewImage": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "publishedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Leetcode",
        "Angular",
        "React",
        "Astro",
        "Frontend",
        "Backend",
        "Fullstack",
        "AI",
        "DevOps",
        "Javascript",
        "Typescript",
        "Git",
        "Tooling"
      ]
    },
    "searchCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personal": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "titleImage",
    "previewImage",
    "description",
    "publishedAt",
    "category",
    "searchCategories",
    "personal"
  ]
}